{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "Jwt": {
    "Issuer": "OsbErpLite",
    "Audience": "OsbErpLiteUsers",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "RateLimiting": {
    "Enabled": false,
    "Auth": {
      "PermitLimit": 0,
      "WindowSeconds": 0
    },
    "PasswordChange": {
      "PermitLimit": 0,
      "WindowSeconds": 0
    },
    "SapSync": {
      "PermitLimit": 0,
      "WindowSeconds": 0
    },
    "Global": {
      "PermitLimit": 0,
      "WindowSeconds": 0
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Dashboard": {
    "LowStockThreshold": 10
  },
  "AllowedHosts": "*"
}
